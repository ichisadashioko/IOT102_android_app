<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_device_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000"
        android:text="sample" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#fff"
            android:background="#000"
            android:layout_margin="10px"
            android:text="FORCE_FAN_ON" />

        <ToggleButton
            android:id="@+id/toggle_button_force_fan_on"
            android:textColor="#fff"
            android:background="#f00"
            android:layout_width="wrap_content"
            android:layout_margin="10px"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <EditText
        android:id="@+id/edit_text_threshold_input"
        android:layout_margin="5px"
        android:textColor="#fff"
        android:background="#222"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/button_set_threshold"
        android:layout_margin="5px"
        android:textColor="#fff"
        android:background="#222"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="set threshold" />

    <Button
        android:id="@+id/button_download_data"
        android:layout_margin="5px"
        android:textColor="#fff"
        android:background="#222"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="download data" />
</LinearLayout>